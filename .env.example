# Daily Focus configuration.
#
# Copy this file to `.env` in the repo root and uncomment what you want to change.
# `.env` is gitignored, because it will hold org names and logins. Every line here
# is a default, so a `.env` with nothing uncommented changes nothing.
#
# A variable set in the real environment always beats the same one in this file.
# Restart the server after editing.

# ---- the store -------------------------------------------------------------

# Where the store lives. The briefing agent must be pointed at the same directory.
# DAILY_FOCUS_DATA=~/.daily-focus

# ---- the server ------------------------------------------------------------

# DAILY_FOCUS_PORT=4321

# Loopback only by default, since this is personal data.
# DAILY_FOCUS_HOST=127.0.0.1

# ---- the working day -------------------------------------------------------

# Local hours the working day starts and ends, used when the brief doesn't say.
# The brief's own dayStart / dayEnd win, since the agent read today's calendar.
# DAILY_FOCUS_WORK_START=9
# DAILY_FOCUS_WORK_END=17

# Minutes before a gap between meetings counts as a focus window.
# DAILY_FOCUS_MIN_FREE_WINDOW=45

# ---- the morning agent -----------------------------------------------------

# Hours before the brief is flagged stale. Counted only in hours a run was due,
# so a weekend never trips it.
# DAILY_FOCUS_STALE_AFTER_HOURS=24

# Weekdays the agent is scheduled on, cron-numbered: 1-5 is Monday to Friday,
# 0-4 is Sunday to Thursday. Inferred from the archive when unset.
# DAILY_FOCUS_AGENT_DAYS=1-5

# ---- the focus timer -------------------------------------------------------

# Default length of a focus session, in minutes.
# DAILY_FOCUS_SESSION_MINUTES=25

# Minutes of an untouched machine before a running session is closed back at the
# last sign of life. 0 turns it off.
# DAILY_FOCUS_AWAY_AFTER=10

# ---- the pull request board ------------------------------------------------

# The board polls GitHub for the pull requests you have open, using whatever
# account the gh CLI is logged in as. Set to `off` to disable it entirely.
# DAILY_FOCUS_GITHUB=on

# Logins to poll as, comma-separated, when gh holds more than one account or the
# active one isn't the one you want. Each is resolved with `gh auth token --user`.
# Unset means the account gh has active.
# DAILY_FOCUS_GITHUB_ACCOUNTS=alice,alice_corp

# Only count pull requests in these organisations or repositories, comma-separated.
# An entry with a slash is a repository, anything else an organisation. Unset means
# every pull request the account has open anywhere.
# DAILY_FOCUS_GITHUB_SCOPE=acme,acme-labs/webapp

# Minutes between polls while a browser tab is open on the dashboard.
# DAILY_FOCUS_GITHUB_POLL_MINUTES=5

# Path to the gh binary, for when the server's PATH doesn't include it.
# DAILY_FOCUS_GH=/opt/homebrew/bin/gh
